#cloud-config
# Generic autoinstall configuration for Precision 7960-class servers.
# Network addresses are obtained from DHCP so this file is independent of
# per-host MAC addresses and static IP assignments.
autoinstall:
  apt:
    disable_components: []
    fallback: offline-install
    geoip: true
    mirror-selection:
      primary:
      - country-mirror
      - arches:
        - amd64
        - arm64
        - i386
        uri: http://archive.ubuntu.com/ubuntu/
      - arches:
        - armhf
        - powerpc
        - ppc64el
        - riscv64
        - s390x
        uri: http://ports.ubuntu.com/ubuntu-ports
    preserve_sources_list: false
    security:
    - arches:
      - amd64
      - arm64
      - i386
      uri: http://security.ubuntu.com/ubuntu/
    - arches:
      - armhf
      - powerpc
      - ppc64el
      - riscv64
      - s390x
      uri: http://ports.ubuntu.com/ubuntu-ports
  codecs:
    install: false
  drivers:
    install: false
  identity:
    hostname: precision87960
    password: $6$TdU513g5Cly/FfJ.$cUlbW6h5BHBxMrlEL7Pjs9TMWZ6heeUOCiQ9gFG9CDzQ6upfDuYK1qU8Q5LBvPRSCnlY4LVP8JF4ThUIxNIat0
    realname: ami
    username: ami
  kernel:
    package: linux-generic
  keyboard:
    layout: jp
    toggle: null
    variant: ''
  locale: en_US.UTF-8
  network:
    bonds:
      bond0:
        dhcp4: true
        interfaces:
        - ens6f0np0
        - ens6f1np1
        optional: true
        parameters:
          mode: balance-alb
    ethernets:
      enp1s0:
        dhcp4: true
        optional: true
      ens6f0np0: {}
      ens6f1np1: {}
    version: 2
  oem:
    install: auto
  source:
    id: ubuntu-server
    search_drivers: false
  ssh:
    allow-pw: true
    authorized-keys: []
    install-server: true
  storage:
    config:
    - transport: pcie
      preserve: true
      id: nvme-controller-nvme0
      type: nvme_controller
    - ptable: gpt
      nvme_controller: nvme-controller-nvme0
      path: /dev/nvme0n1
      wipe: superblock-recursive
      preserve: false
      name: ''
      grub_device: false
      id: disk-nvme0n1
      type: disk
    - device: disk-nvme0n1
      size: 1127219200
      wipe: superblock
      flag: boot
      number: 1
      preserve: false
      grub_device: true
      offset: 1048576
      path: /dev/nvme0n1p1
      id: partition-0
      type: partition
    - device: disk-nvme0n1
      size: 2147483648
      wipe: superblock
      number: 2
      preserve: false
      grub_device: false
      offset: 1128267776
      path: /dev/nvme0n1p2
      id: partition-1
      type: partition
    - device: disk-nvme0n1
      size: -1
      wipe: superblock
      number: 3
      preserve: false
      grub_device: false
      offset: 3275751424
      path: /dev/nvme0n1p3
      id: partition-2
      type: partition
    - fstype: fat32
      volume: partition-0
      preserve: false
      id: format-0
      type: format
    - fstype: ext4
      volume: partition-1
      preserve: false
      id: format-1
      type: format
    - name: ubuntu-vg
      devices:
      - partition-2
      preserve: false
      id: lvm_volgroup-0
      type: lvm_volgroup
    - name: ubuntu-lv
      volgroup: lvm_volgroup-0
      size: -1
      wipe: superblock
      preserve: false
      path: /dev/ubuntu-vg/ubuntu-lv
      id: lvm_partition-0
      type: lvm_partition
    - fstype: ext4
      volume: lvm_partition-0
      preserve: false
      id: format-3
      type: format
    - path: /
      device: format-3
      id: mount-3
      type: mount
    - path: /boot
      device: format-1
      id: mount-1
      type: mount
    - path: /boot/efi
      device: format-0
      id: mount-0
      type: mount
  late-commands:
    - mkdir -p /target/cdrom
    - mount --bind /cdrom /target/cdrom
    - mkdir -p /target/root/autoinstall/scripts
    - |
      set -eu
      cp /cdrom/scripts/install-offline-packages.sh /target/root/autoinstall/scripts/
      cp /cdrom/scripts/restore-config.sh /target/root/autoinstall/scripts/
      chmod 0755 /target/root/autoinstall/scripts/*.sh
    - curtin in-target --target=/target -- /root/autoinstall/scripts/install-offline-packages.sh /cdrom/packages
    - curtin in-target --target=/target -- /root/autoinstall/scripts/restore-config.sh
    - umount /target/cdrom
  updates: security
  version: 1